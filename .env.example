# Copy this file to .env for local Docker Compose development.
SERVER_NAME="attendance-crmt"
SERVER_INSTRUCTIONS="Interact with the CRMT attendance system."

ENVIRONMENT=development # development / production

ATTENDANCE_DATABASE_URL=mssql+pyodbc://<username>:<password>@<server>/<database>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Optional. Defaults to data/audit.sqlite3.
ATTENDANCE_AUDIT_DATABASE_PATH=data/audit.sqlite3

# The public MCP endpoint and Entra delegated-token validation settings.
# Replace every placeholder with the values for the Attendance CRMT API and
# approved Teams bot client applications. ATTENDANCE_ENTRA_ALLOWED_CLIENT_IDS
# is a JSON array, even when only one client is allowed.
ATTENDANCE_MCP_BASE_URL=https://attendance.example.com
ATTENDANCE_ENTRA_TENANT_ID=<tenant-id>
ATTENDANCE_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
ATTENDANCE_ENTRA_OPENID_CONFIGURATION_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
ATTENDANCE_ENTRA_AUDIENCE=api://<attendance-crmt-api-app-id>
ATTENDANCE_ENTRA_ALLOWED_CLIENT_IDS=["<approved-teams-bot-client-id>"]
# Optional. These defaults are shown for clarity.
ATTENDANCE_ENTRA_REQUIRED_SCOPE=attendance.access
ATTENDANCE_ENTRA_CLOCK_SKEW_SECONDS=60
ATTENDANCE_ENTRA_ADMIN_ROLE=attendance.admin
